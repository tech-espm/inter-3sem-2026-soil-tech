    justify-content: center;
    text-align: center;

    position: relative;
    overflow: hidden;
}

.hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.5);
}

.hero div {
    position: relative;
    z-index: 1;
}

.hero h1 {
    font-size: 64px;
    font-weight: 700;
    letter-spacing: 1px;
    color: white;
}

.hero p {
    color: white;
    font-size: 18px;
    margin-top: 10px;
