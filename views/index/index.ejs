<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const ctx = document.getElementById("grafico");

const grafico = new Chart(ctx, {
    type: "line",
    data: {
        labels: [],
        datasets: [
            { label: "Temperatura",   data: [], borderColor: "#ef4444", tension: 0.3 },
            { label: "Umidade",       data: [], borderColor: "#3b82f6", tension: 0.3 },
            { label: "Condutividade", data: [], borderColor: "#16a34a", tension: 0.3 }
        ]
    },
    options: {
        responsive: true,
        plugins: { legend: { position: "top" } }
    }
});

function getFiltro() {
    const hoje = new Date().toISOString().split("T")[0];
    const seteDias = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString().split("T")[0];
    return {
        data_inicial: document.getElementById("f-data-inicial").value || seteDias,
        data_final:   document.getElementById("f-data-final").value   || hoje,
        hora_inicial: document.getElementById("f-hora-inicial").value  || "00:00",
        hora_final:   document.getElementById("f-hora-final").value    || "23:59"
    };
}

async function carregarHistorico() {
    const f = getFiltro();
    const params = new URLSearchParams(f);
    const res = await fetch("/dados/historico?" + params);
    const lista = await res.json();

    grafico.data.labels = lista.map(d => d.hora);
    grafico.data.datasets[0].data = lista.map(d => d.temperatura);
    grafico.data.datasets[1].data = lista.map(d => d.umidade);
    grafico.data.datasets[2].data = lista.map(d => d.condutividade);

    if (lista.length > 0) {
        const ultimo = lista[lista.length - 1];
        document.getElementById("temp").innerText = ultimo.temperatura + " °C";
        document.getElementById("umidade").innerText = ultimo.umidade + " %";
        document.getElementById("cond").innerText = ultimo.condutividade + " μS/cm";
    }

    grafico.update();
}

async function gerarHeatmap() {
    const f = getFiltro();
    const params = new URLSearchParams(f);
    const res = await fetch("/heatmap?" + params);
    const dados = await res.json();

    const container = document.getElementById("heatmap");
    container.innerHTML = "";

    if (!dados.length) {
        container.innerHTML = "<p style='color:#888; margin-top:10px;'>Nenhum dado no período selecionado.</p>";
        return;
    }

    const grid = document.createElement("div");
    grid.className = "heatmap-grid";

    grid.appendChild(document.createElement("div"));
    for (let h = 0; h < 24; h++) {
        const hora = document.createElement("div");
        hora.className = "label";
        hora.innerText = h + "h";
        grid.appendChild(hora);
    }

    dados.forEach((linha, d) => {
        const dia = document.createElement("div");
        dia.className = "label label-day";
        dia.innerText = "Dia " + (d + 1);
        grid.appendChild(dia);

        linha.forEach(umidade => {
            let cor = umidade < 50 ? "#ef4444" : umidade < 65 ? "#f59e0b" : "#16a34a";
            const cell = document.createElement("div");
            cell.className = "heat-cell";
            cell.style.background = cor;
            grid.appendChild(cell);
        });
    });

    container.appendChild(grid);
}

async function atualizar() {
    const res = await fetch("/dados");
    const data = await res.json();
    document.getElementById("temp").innerText = data.temperatura + " °C";
    document.getElementById("umidade").innerText = data.umidade + " %";
    document.getElementById("cond").innerText = data.condutividade + " μS/cm";
}

function aplicarFiltro() {
    carregarHistorico();
    gerarHeatmap();
}

function resetarFiltro() {
    document.getElementById("f-data-inicial").value = "";
    document.getElementById("f-data-final").value = "";
    document.getElementById("f-hora-inicial").value = "00:00";
    document.getElementById("f-hora-final").value = "23:59";
    aplicarFiltro();
}

window.addEventListener("scroll", () => {
    const nav = document.querySelector("nav");
    if (window.scrollY > 50) nav.classList.add("scrolled");
    else nav.classList.remove("scrolled");
});

setInterval(atualizar, 600000);
carregarHistorico();
gerarHeatmap();

</script>

