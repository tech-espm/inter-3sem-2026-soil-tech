    padding-bottom: 80px;
}

.dashboard h2 {
    color: #16a34a;
}

/* CARDS */
.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.card {
    background: #ffffff;
    padding: 25px;
    border-radius: 20px;
    border-top: 4px solid #16a34a;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
}

.card:nth-child(1) { border-top-color: #ef4444; }
.card:nth-child(2) { border-top-color: #3b82f6; }
.card:nth-child(3) { border-top-color: #16a34a; }

.card h3 {
    font-size: 14px;
    color: #6b7280;
}

.card p {
    font-size: 32px;
    font-weight: bold;
    margin-top: 10px;
    color: #111827;
}

/* GRAFICO */
canvas {
    background: #ffffff;
    padding: 20px;
    border-radius: 16px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

/* HEATMAP */
#heatmap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 20px;
}

.heat-row {
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: 3px;
}

.heat-cell {
    height: 18px;
    border-radius: 3px;
    cursor: pointer;
    transition: 0.2s;
}

.heat-cell:hover {
    transform: scale(1.4);
}

/* FOOTER */
.footer {
    background: #111827;
    color: #d1d5db;
    padding: 40px;
    font-size: 14px;
}

.footer-container {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

.footer-links {
    display: flex;
    flex-direction: column;
}

.footer-links a {
    color: #9ca3af;
    text-decoration: none;
    margin: 5px 0;
}

.footer-links a:hover {
    color: white;
}

.footer-contact p {
    margin: 5px 0;
}

.hero svg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 120px;
}

.hero svg path {
    fill: #ffffff; /* mesma cor da próxima seção */
}

/* CONTAINER GERAL */
#heatmap {
    margin-top: 20px;
    overflow-x: auto;
}

/* GRID COMPLETO (com labels) */
.heatmap-grid {
    display: grid;
    grid-template-columns: 80px repeat(24, 1fr);
    gap: 4px;
    align-items: center;
}

/* LABELS (dia/hora) */
.label {
    font-size: 12px;
    color: #6b7280;
    text-align: center;
}

/* LABEL DIA (lado esquerdo) */
.label-day {
    text-align: right;
    padding-right: 10px;
    font-weight: 500;
}

/* CÉLULAS */
.heat-cell {
    height: 20px;
    border-radius: 4px;
    cursor: pointer;
    transition: 0.2s;
}

.heat-cell:hover {
    transform: scale(1.3);
}

</style>
</head>
