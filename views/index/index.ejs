<script>

const ctx = document.getElementById("grafico");

const grafico = new Chart(ctx, {
    type: "line",
    data: {
        labels: [],
        datasets: [
            { label: "Temperatura", data: [], borderColor: "#ef4444" },
            { label: "Umidade", data: [], borderColor: "#3b82f6" },
            { label: "Condutividade", data: [], borderColor: "#16a34a" }
        ]
    }
});

async function atualizar() {

    const res = await fetch("/dados");
    const data = await res.json();

    document.getElementById("temp").innerText = data.temperatura + " °C";
    document.getElementById("umidade").innerText = data.umidade + " %";
    document.getElementById("cond").innerText = data.condutividade + " μS/cm";

    grafico.data.labels.push(data.hora);

    grafico.data.datasets[0].data.push(data.temperatura);
    grafico.data.datasets[1].data.push(data.umidade);
    grafico.data.datasets[2].data.push(data.condutividade);

    grafico.data.datasets.forEach(d => {
        if (d.data.length > 10) d.data.shift();
    });

    grafico.update();
}

async function gerarHeatmap() {

    const res = await fetch("/heatmap");
    const dados = await res.json();

    const container = document.getElementById("heatmap");
    container.innerHTML = "";

    const grid = document.createElement("div");
    grid.className = "heatmap-grid";

    grid.appendChild(document.createElement("div"));

    for (let h = 0; h < 24; h++) {
        const hora = document.createElement("div");
        hora.className = "label";
        hora.innerText = h + "h";
        grid.appendChild(hora);
    }

    dados.forEach((linha, d) => {

        const dia = document.createElement("div");
        dia.className = "label label-day";
        dia.innerText = "Dia " + (d + 1);
        grid.appendChild(dia);

        linha.forEach((umidade, h) => {

            let cor =
                umidade < 50 ? "#ef4444" :
                umidade < 65 ? "#f59e0b" :
                "#16a34a";

            const cell = document.createElement("div");
            cell.className = "heat-cell";
            cell.style.background = cor;

            grid.appendChild(cell);
        });
    });

    container.appendChild(grid);
}

/* NAV muda ao rolar */


window.addEventListener("scroll", () => {
    const nav = document.querySelector("nav");
    if (window.scrollY > 50) {
        nav.classList.add("scrolled");
    } else {
        nav.classList.remove("scrolled");
    }
});

setInterval(atualizar, 600000);
atualizar();
gerarHeatmap();

</script>

<%- contentFor("espaco-head") %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

html {
    scroll-behavior: smooth;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Segoe UI", sans-serif;
}

body {
    background: #ffffff;
    color: #111827;
}

/* NAV (UNIFICADO E CORRIGIDO) */
nav {
    position: fixed;
    width: 100%;
    top: 0;
    display: flex;
    justify-content: space-between;
    padding: 20px 40px;
    background: transparent;
    border-bottom: none;
    z-index: 1000;
    transition: 0.3s;
}

nav a {
    margin: 0 15px;
    text-decoration: none;

    background: transparent;
    border: none;
    padding: 0;
    border-radius: 0;
    box-shadow: none;

    outline: none;
    appearance: none;

    color: white;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.5px;

    position: relative;
    cursor: pointer;
}

/* LOGO */
nav div:first-child {
    color: white;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* NAV AO ROLAR */
nav.scrolled {
    background: #111827;
    border-bottom: 1px solid #1f2937;
}

/* LINHA ANIMADA */
nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 0%;
    height: 2px;
    background: white;
    transition: 0.3s;
}

nav a:hover::after {
    width: 100%;
}

/* HERO */
.hero {
