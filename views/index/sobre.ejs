<script>
window.addEventListener("scroll", () => {
    const nav = document.querySelector("nav");
    if (window.scrollY > 50) {
        nav.classList.add("scrolled");
    } else {
        nav.classList.remove("scrolled");
    }
});

document.querySelectorAll('.cultura-tab').forEach(tab => {
    tab.addEventListener('click', () => {
        document.querySelectorAll('.cultura-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.cultura-texto').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('texto-' + tab.dataset.tab).classList.add('active');
    });
});
</script>

