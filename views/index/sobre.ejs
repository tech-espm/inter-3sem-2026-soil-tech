    font-weight: 900;
    color: white;
    letter-spacing: 3px;
    margin-bottom: 50px;
}

.pilares {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
}

.pilar {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
    padding: 40px 30px;
    color: white;
    transition: 0.3s;
}

.pilar:hover {
    background: rgba(255,255,255,0.15);
