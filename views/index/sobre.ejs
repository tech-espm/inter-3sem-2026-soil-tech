<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Segoe UI", sans-serif;
}

body {
    background: #f4f6f8;
    color: #111;
}

/* NAV */
nav {
    display: flex;
    justify-content: space-between;
    padding: 20px 40px;
    background: white;
}

nav a {
    margin: 0 10px;
    text-decoration: none;
    color: #111;
    font-weight: 500;
}

/* CONTAINER */
.container {
    max-width: 900px;
    margin: 100px auto;
    padding: 30px;
    background: white;
    border-radius: 10px;
}

/* TEXTO */
h1 {
    font-size: 42px;
    margin-bottom: 25px;
}

p {
    font-size: 16px;
    line-height: 1.9;
    margin-bottom: 20px;
    text-align: justify;
}

/* TIME */
.team {
    margin-top: 40px;
    padding-top: 25px;
    border-top: 1px solid #ddd;
}

.team h2 {
    font-size: 28px;
    margin-bottom: 20px;
}

/* CARD DOS MEMBROS */
.members {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.member {
    background: #f4f6f8;
    padding: 15px;
    border-radius: 10px;
    text-align: center;
    transition: 0.3s;
}

.member:hover {
    transform: scale(1.03);
}

.member img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 10px;
}

.member h3 {
    margin-bottom: 5px;
    font-size: 18px;
}
</style>
